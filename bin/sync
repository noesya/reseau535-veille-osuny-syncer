#!/usr/bin/env ruby

require 'rubygems'
require 'bundler/setup'
Bundler.require(:default)
Dotenv.load

require_relative '../lib/grist/client'

OsunyApi.configure do |config|
  config.api_key['X-Osuny-Token'] = ENV['OSUNY_API_TOKEN']
  config.scheme = ENV['OSUNY_API_SCHEME'] || 'https'
  config.host = ENV['OSUNY_API_HOST']
  config.base_path = '/api/osuny/v1'
  # config.debugging = true
end

[
  Grist::Models::Departement,
  Grist::Models::Discipline,
  Grist::Models::Thematique,
  Grist::Models::Organisation,
  Grist::Models::Spectacle
].each do |klass|
  recently_updated_records = klass.recently_updated
  puts "[#{klass.name.split('::').last}] #{recently_updated_records.count} éléments récemment mis à jour (total: #{klass.all.count})."
  recently_updated_records.each(&:sync_to_osuny)
end
