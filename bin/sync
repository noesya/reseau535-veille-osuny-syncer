#!/usr/bin/env ruby

require 'rubygems'
require 'bundler/setup'
Bundler.require(:default)
Dotenv.load
Bundler.require(ENV['RUBY_ENV']) if ENV['RUBY_ENV']

require_relative '../lib/grist/client'

OsunyApi.configure do |config|
  config.api_key['X-Osuny-Token'] = ENV['OSUNY_API_TOKEN']
  config.scheme = ENV['OSUNY_API_SCHEME'] || 'https'
  config.host = ENV['OSUNY_API_HOST']
  config.base_path = '/api/osuny/v1'
  # config.debugging = true
end

models_scope = ARGV[0] == "--all" ? :all : :recently_updated
if models_scope == :all
  puts "Synchronisation de tous les modèles."
else
  puts "Synchronisation des modèles récemment mis à jour."
end

def sync_model(klass, scope)
  records = klass.public_send(scope)
  if scope == :all
    # Sync all
    puts "[#{klass.name.split('::').last}] #{records.count} éléments."
  else
    # Sync recentlty updated
    puts "[#{klass.name.split('::').last}] #{records.count} éléments récemment mis à jour (total: #{klass.all.count})."
  end
  records.each(&:sync_to_osuny)
end

[
  Grist::Models::Departement,
  Grist::Models::Discipline,
  Grist::Models::Thematique,
  Grist::Models::Spectacle::Etat,
  Grist::Models::Spectacle::Etape::Etat,
  Grist::Models::Organisation,
  Grist::Models::Spectacle::Etape,
  Grist::Models::Spectacle
].each do |klass|
  sync_model(klass, models_scope)
end
