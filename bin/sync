#!/usr/bin/env ruby

require 'rubygems'
require 'bundler/setup'
Bundler.require(:default)
Dotenv.load

require_relative '../lib/grist/client'

OsunyApi.configure do |config|
  config.api_key['X-Osuny-Token'] = ENV['OSUNY_API_TOKEN']
  config.scheme = ENV['OSUNY_API_SCHEME'] || 'https'
  config.host = ENV['OSUNY_API_HOST']
  config.base_path = '/api/osuny/v1'
  # config.debugging = true
end

# On charge les départements depuis Grist et on les synchronise vers osuny
departements = Grist::Models::Departement.all
puts "#{departements.count} départements chargés depuis Grist."
# Ca c'est impeccable, le puts devrait être dedans, dans le base, ça allègerait
departements.each(&:sync_to_osuny)

# # On charge les disciplines depuis Grist et on les synchronise vers osuny
disciplines = Grist::Models::Discipline.all
puts "#{disciplines.count} disciplines chargées depuis Grist."
disciplines.each(&:sync_to_osuny)

# # On charge les thématiques depuis Grist et on les synchronise vers osuny
thematiques = Grist::Models::Thematique.all
puts "#{thematiques.count} thématiques chargées depuis Grist."
thematiques.each(&:sync_to_osuny)

# On charge les organisations depuis Grist et on les synchronise vers osuny
organisations = Grist::Models::Organisation.all
puts "#{organisations.count} organisations chargées depuis Grist."
organisations.each do |organisation|
  # On associe les départements à l'organisation avant de la synchroniser vers osuny
  departements = organisation.departement_ids.map { |departement_id|
    departements.find { |departement| departement.id == departement_id }
  }.compact
  organisation.departements = departements
  # On associe les opérateurs à l'organisation avant de la synchroniser vers osuny
  operateurs = organisation.operateur_ids.map { |operateur_id|
    organisations.find { |organisation| organisation.id == operateur_id }
  }.compact
  organisation.operateurs = operateurs
  # On gère la direction inverse, en associant les organisations opérées
  operating_organisations = organisations.select { |organisation|
    organisation.operateur_ids.include?(organisation.id)
  }
  organisation.operating_organisations = operating_organisations
  # Enfin, on synchronise l'organisation vers osuny
  organisation.sync_to_osuny
end

spectacles = Grist::Models::Spectacle.all
puts "#{spectacles.count} spectacles chargés depuis Grist."
etapes = Grist::Models::Spectacle::Etape.all
puts "#{etapes.count} étapes chargées depuis Grist."
